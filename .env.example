# ── NEELGRIVA environment configuration ──────────────────────────────
# Copy to .env and fill in real values. Never commit .env.
# The frontend must NEVER contain these values.

# ── Application ──
APP_ENV=development
APP_DEMO_MODE=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Database (PostgreSQL + PostGIS) ──
# When DATABASE_URL is empty, the backend falls back to a local SQLite store
# so the demo pipeline still runs without a database server.
DATABASE_URL=
# Example: postgresql+psycopg://neelgriva:secret@localhost:5432/neelgriva
POSTGIS_ENABLED=true

# ── Redis ──
# When empty, an in-process memory cache is used for the demo.
REDIS_URL=

# ── Data-source credentials (leave blank to use demo/synthetic data) ──
# Sentinel-1 / Copernicus Data Space
COPERNICUS_USER=
COPERNICUS_PASSWORD=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ERA5 (CDS) API
CDSAPI_URL=https:// cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Copernicus Marine (CMEMS)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Bhoonidhi (NRSC) — token if required
BHOONIDHI_TOKEN=

# Historical AIS provider
AIS_PROVIDER_URL=
AIS_PROVIDER_KEY=

# ── ML models ──
# Path to a trained YOLO11-seg oil-slick weights file.
# If empty, the backend uses the clearly-labelled mock detector (demo mode).
OIL_SLICK_MODEL_PATH=
VESSEL_ANOMALY_MODEL_PATH=
